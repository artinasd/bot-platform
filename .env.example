# Runtime
NODE_ENV=development
APP_URL=http://localhost:3000
APP_REGION=iad1
PLATFORM_NAME=Bot Platform
LOG_LEVEL=info

# Supabase PostgreSQL
# Runtime URL: Supavisor transaction pooler, port 6543, pgbouncer enabled.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1
# Direct URL: used only for Prisma schema operations, port 5432.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Upstash Redis REST credentials
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# QStash (optional until asynchronous dispatch is enabled)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Internal dispatch authentication (use a random secret of at least 32 characters)
INTERNAL_JOB_SECRET=

# Encryption key: generate a unique 32-byte key and encode as base64.
CREDENTIAL_ENCRYPTION_KEY=

# Auth/session configuration
AUTH_SECRET=
SESSION_COOKIE_NAME=bot_platform_session
SESSION_TTL_SECONDS=86400

# Optional platform bootstrap identity; never use a default password.
PLATFORM_BOOTSTRAP_EMAIL=
PLATFORM_BOOTSTRAP_PASSWORD=

# Optional Telegram configuration for platform-owned notifications.
TELEGRAM_PLATFORM_BOT_TOKEN=
TELEGRAM_WEBHOOK_BASE_URL=

# Storage adapter (Supabase Storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=platform-assets

# Test settings
TEST_DATABASE_URL=
